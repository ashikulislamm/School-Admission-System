# Copy to .env to override defaults. Never commit .env.
# Every value here is optional: docker compose works with none of them set.

# Local Postgres container (docker compose)
POSTGRES_USER=admission
POSTGRES_PASSWORD=admission
POSTGRES_DB=admission
DB_HOST_PORT=5433

# Backend
HOLD_DURATION_SECONDS=600
CORS_ORIGINS=http://localhost:3000

# Cloud database (Neon/Supabase). Use the DIRECT, non-pooled connection.
# Set this on Render's dashboard, not in a committed file.
# ConnectionStrings__Default=Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require
