# Used only by `dotnet run` (Development). Copy to backend/.env. Never commit .env.
# Docker and Render use real environment variables instead; those always win over this file.

# Local Postgres from docker compose (host port 5433)
ConnectionStrings__Default=Host=localhost;Port=5433;Database=admission;Username=admission;Password=admission

# Cloud database (Neon/Supabase): use the DIRECT, non-pooled connection. URL or key-value both work.
# ConnectionStrings__Default=postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname

HOLD_DURATION_SECONDS=600
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
